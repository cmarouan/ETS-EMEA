# Local Docker development defaults only; never use these secrets in production.
APP_ENV=dev
APP_DEBUG=1
APP_SECRET=docker-development-only-change-for-production
MONGODB_URI=mongodb://database:27017
MONGODB_DB=ets_emea
JWT_SECRET_KEY=/var/lib/jwt/private.pem
JWT_PUBLIC_KEY=/var/lib/jwt/public.pem
JWT_PASSPHRASE=docker-development-only
CORS_ALLOW_ORIGIN='^http://(localhost|127\.0\.0\.1):3000$'
